# dbt profile for the `{{ product }}` medallion data product.
# Generated by dsl-medallion.
#
# Kept inside the project directory so `dbt` finds it when run with this
# directory as the working directory (as the generated Airflow DAG does).
# `path` points at the one database the DDL and ingestion script also use.
{{ product }}:
  target: dev
  outputs:
    dev:
      type: duckdb
      path: "{{ database }}"
      threads: 1
