# dbt project for the `{{ product }}` medallion data product.
# Generated by dsl-medallion.
#
# Model directories are created for every layer but left empty: the
# transformation SQL is yours to write, and is deliberately not generated.
name: "{{ product }}"
version: "1.0.0"
config-version: 2

profile: "{{ product }}"

# Only the directories this scaffold actually creates are declared; dbt's
# defaults cover the rest.
model-paths: ["models"]
macro-paths: ["macros"]

models:
  {{ product }}:
{% for layer in layers %}
    {{ layer.name }}:
      +schema: "{{ layer.schema }}"
      +materialized: {{ layer.materialized }}
{% endfor %}
