-- Schema DDL for the `{{ product }}` medallion data product (DuckDB).
-- Generated by dsl-medallion.
--
-- Schemas are created in layer-dependency order. Tables are created only for
-- layers that declare `load`; tables in derived layers emerge from the dbt
-- transformations you write, so none are invented here.
{% for layer in layers %}

CREATE SCHEMA IF NOT EXISTS "{{ layer.name }}";
{% for table in layer.tables %}

CREATE TABLE IF NOT EXISTS "{{ layer.name }}"."{{ table.name }}" (
{% for column in table.columns %}
    "{{ column.name }}" {{ column.type }}{{ "," if not loop.last else "" }}
{% endfor %}
);
{% endfor %}
{% endfor %}
