"""Airflow DAG for the `{{ product }}` medallion data product.

Generated by dsl-medallion.

The task graph is the ingestion step followed by the layer-dependency graph
declared in the specification: `{{ ingestion_task }}` loads the declared CSV
sources, then one task per layer invokes dbt, wired in dependency order.

It expresses the medallion transitions and nothing else -- no sensors, no
branching, no retry policy. Applying `schema/ddl.sql` is a deployment step and
is deliberately not a task here.
"""

from __future__ import annotations

import datetime
import os
import pathlib

from airflow.providers.standard.operators.bash import BashOperator
from airflow.sdk import DAG

# This file lives at <product>/orchestration/dags/.
PRODUCT_DIR = pathlib.Path(__file__).resolve().parents[2]
DBT_PROJECT_DIR = PRODUCT_DIR / "dbt"
INGESTION_SCRIPT = PRODUCT_DIR / "ingestion" / "load_bronze.py"

# Source paths are taken verbatim from the specification, so they are relative to
# wherever the raw data is deployed. Set MEDALLION_SOURCE_ROOT on the worker; it
# defaults to the product directory.
SOURCE_ROOT = os.environ.get("MEDALLION_SOURCE_ROOT", str(PRODUCT_DIR))

with DAG(
    dag_id="{{ product }}",
    description="Medallion pipeline for {{ product }}",
    schedule="{{ schedule }}",
    start_date=datetime.datetime({{ start_year }}, {{ start_month }}, {{ start_day }}),
    catchup=False,
    tags=["medallion", "generated"],
) as dag:
    task_{{ ingestion_task }} = BashOperator(
        task_id="{{ ingestion_task }}",
        bash_command=f"python {INGESTION_SCRIPT} --source-root {SOURCE_ROOT}",
    )
{% for layer in layers %}
    task_{{ layer }} = BashOperator(
        task_id="{{ layer }}",
        bash_command=f"cd {DBT_PROJECT_DIR} && dbt {{ dbt_command }} --select {{ layer }}",
    )
{% endfor %}

{% for layer in ingested %}
    task_{{ ingestion_task }} >> task_{{ layer }}
{% endfor %}
{% for edge in edges %}
    task_{{ edge.upstream }} >> task_{{ edge.downstream }}
{% endfor %}
