{#- Generated by dsl-medallion.

    dbt's default `generate_schema_name` prefixes a model's custom schema with the
    target schema (`main_bronze`). This override makes `+schema: bronze` mean the
    schema `bronze` exactly, so dbt models materialise into the same layer schemas
    that the generated DDL creates.

    This is project plumbing, not transformation logic: it configures where models
    land, and generates no business SQL.
-#}
{% raw %}{% macro generate_schema_name(custom_schema_name, node) -%}
    {%- if custom_schema_name is none -%}
        {{ target.schema }}
    {%- else -%}
        {{ custom_schema_name | trim }}
    {%- endif -%}
{%- endmacro %}
{% endraw %}
