# dbt sources for the `{{ product }}` medallion data product.
# Generated by dsl-medallion.
#
# One dbt source per layer that ingests raw data, mirroring the tables created
# by the generated DDL. Reference them from your models with the dbt
# source() function, e.g. source('{{ example_layer }}', '{{ example_table }}').
version: 2

sources:
{% for source in sources %}
  - name: {{ source.layer }}
    schema: {{ source.schema }}
    description: "Raw data ingested into the {{ source.layer }} layer."
    tables:
{% for table in source.tables %}
      - name: {{ table.name }}
        description: "Ingested from {{ table.path }}"
        columns:
{% for column in table.columns %}
          - name: {{ column.name }}
            data_type: {{ column.type }}
{% endfor %}
{% endfor %}
{% endfor %}
